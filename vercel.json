{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/katha", "destination": "/story.html" },
    { "source": "/story", "destination": "/story.html" },
    { "source": "/lyrics", "destination": "/lyrics.html" },
    { "source": "/darshan", "destination": "/index.html?direct=1" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|mp3|webp|jpg|png|svg|ico|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(index|story|katha|lyrics|darshan)?(\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
