{
  "cleanUrls": true,
  "redirects": [
    { "source": "/lyrics", "destination": "/lyrics/english", "permanent": true },
    { "source": "/katha", "destination": "/katha/english", "permanent": true }
  ],
  "rewrites": [
    { "source": "/lyrics", "destination": "/index" },
    { "source": "/lyrics/:lang([a-zA-Z0-9_-]+)", "destination": "/index" },
    { "source": "/hindi-lyrics", "destination": "/index" },
    { "source": "/odia-lyrics", "destination": "/index" },
    { "source": "/bengali-lyrics", "destination": "/index" },
    { "source": "/russian-lyrics", "destination": "/index" },
    { "source": "/english-lyrics", "destination": "/index" },
    { "source": "/katha", "destination": "/katha" },
    { "source": "/katha/:lang([a-zA-Z0-9_-]+)", "destination": "/katha" },
    { "source": "/darshan", "destination": "/darshan" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|mp3|webp|jpg|png|svg|ico|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(index|katha|lyrics|darshan|lyrics/.*|katha/.*)?(\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
